PORT=3000
NODE_ENV=development

# SQL Database configuration (defaults to local SQLite file; supports postgres or mysql via DATABASE_URL)
DB_DIALECT=sqlite
DB_STORAGE=./data/snooker_booking.sqlite
DATABASE_URL=

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Configure these to enable password reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set these before running `npm run seed:admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional demo-account email/name overrides. The seed script generates passwords.
DEMO_PLAYER_NAME=Demo Player
DEMO_PLAYER_EMAIL=demo-player@snookerbooking.test
DEMO_ADMIN_NAME=Demo Administrator
DEMO_ADMIN_EMAIL=demo-admin@snookerbooking.test
